{{!
    @template local_gradeheatmap/palette_editor

    Palette editor: colours from lowest to highest, each with the percentage it starts at.
    The local_gradeheatmap/palette_editor module adds and removes colours.

    Context variables required for this template:
    * name - Form field name prefix.
    * rows - The colours, see local_gradeheatmap/palette_row.
    * newrow - Context for a colour added by the user.
    * disabled - Whether the inputs are disabled.
    * mincolours - Fewest colours allowed.
    * maxcolours - Most colours allowed.

    Example context (json):
    {
        "name": "s_local_gradeheatmap_palette",
        "rows": [
            {"name": "s_local_gradeheatmap_palette", "number": 1, "from": 0, "colour": "#f28b82", "first": true},
            {"name": "s_local_gradeheatmap_palette", "number": 2, "from": 100, "colour": "#8ab4f8", "first": false}
        ],
        "newrow": {"name": "s_local_gradeheatmap_palette", "number": 0, "from": "", "colour": "#ffffff", "first": false},
        "disabled": false,
        "mincolours": 2,
        "maxcolours": 20
    }
}}
<div class="local-gradeheatmap-palette" data-region="local-gradeheatmap-palette"
    data-mincolours="{{mincolours}}" data-maxcolours="{{maxcolours}}">
    <p class="form-text text-muted mt-0">{{#str}}palette_help, local_gradeheatmap{{/str}}</p>
    <div class="mb-2" data-region="rows">
        {{#rows}}
            {{> local_gradeheatmap/palette_row }}
        {{/rows}}
    </div>
    <button type="button" class="btn btn-secondary btn-sm" data-action="add" {{#disabled}}disabled{{/disabled}}>
        {{#str}}addcolour, local_gradeheatmap{{/str}}
    </button>
    <template data-region="newrow">
        {{#newrow}}
            {{> local_gradeheatmap/palette_row }}
        {{/newrow}}
    </template>
</div>
