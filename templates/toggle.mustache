{{!
    @template local_gradeheatmap/toggle

    Per-user switch for the grade heatmap. Rendered hidden in the page footer;
    the local_gradeheatmap/heatmap module moves it into the grader report's action bar.

    Context variables required for this template:
    * checked - Whether the heatmap is switched on for the current user.

    Example context (json):
    {
        "checked": true
    }
}}
<div class="navitem align-self-center local-gradeheatmap-togglewrapper" data-region="local-gradeheatmap-toggle" hidden>
    <div class="form-check form-switch mb-0">
        <input type="checkbox" class="form-check-input" id="local-gradeheatmap-toggle"
            data-action="local-gradeheatmap-toggle" {{#checked}}checked{{/checked}}
            aria-describedby="local-gradeheatmap-toggle-help">
        <label class="form-check-label" for="local-gradeheatmap-toggle">{{#str}}toggle, local_gradeheatmap{{/str}}</label>
        <span id="local-gradeheatmap-toggle-help" class="visually-hidden">{{#str}}toggle_help, local_gradeheatmap{{/str}}</span>
    </div>
</div>
